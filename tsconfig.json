{
  // The harness, the adapter, and the port's conformance tests: TypeScript that imports the
  // app's source by its ~/ alias and runs on the app's packages (node_modules links to
  // app/node_modules).
  "extends": "./app/tsconfig.json",
  // harness/scaling and the performance gate import the app's load harness as
  // deploy/load/app.patch changes it; tsconfig.load.json checks them with the patch applied.
  "include": ["adapter/**/*.ts", "adapter/*.tsx", "conformance/**/*.ts", "harness/**/*.ts"],
  "exclude": ["**/node_modules", "harness/scaling", "harness/perf-gate.ts"],
  "compilerOptions": {
    "types": ["vite/client", "bun"],
    "paths": {
      "~/*": ["./app/src/*"]
    }
  }
}
