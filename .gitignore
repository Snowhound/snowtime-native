/target
# node_modules at the root is a tracked link to app/node_modules; the adapter's own packages
# install beside it.
/adapter/node_modules/
/adapter/dist/
/adapter/bench/node_modules/
/adapter/bench/dist/
/crates/render/results/
__pycache__/
.DS_Store

# Session notes and handovers, not committed
/temp/

# A local Compose deployment's settings and bucket keys
/deploy/compose/.env
/deploy/compose/litestream.env
